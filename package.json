{
  "name": "superatom-workers",
  "version": "1.0.0",
  "private": true,
  "description": "SuperAtom Cloudflare Workers monorepo",
  "scripts": {
    "dev:websocket": "npm run dev -w packages/websocket",
    "dev:api": "npm run dev -w packages/api",
    "deploy:websocket": "npm run deploy -w packages/websocket",
    "deploy:api": "npm run deploy -w packages/api",
    "deploy:all": "npm run deploy:websocket && npm run deploy:api",
    "type-check": "npm run type-check -w packages/websocket && npm run type-check -w packages/api"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}